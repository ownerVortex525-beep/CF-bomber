# 🔑 TELEGRAM
BOT_TOKEN=7183762264:AAEa9u2kVxXXXXXXXXXXXXXXXXXXXXXXXXXXX
OWNER_ID=8485274140

# 📢 FORCE-JOIN CHANNELS
CHANNEL_1_ID=-1002914494697
